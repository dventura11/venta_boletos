module(
    name = "ticketera_app",
    version = "1.0.0",
)

# Versiones correctas para tu instalación de Bazel 9
bazel_dep(name = "rules_java", version = "9.1.0")
bazel_dep(name = "rules_jvm_external", version = "6.7")

# Configurar dependencias de Spring Boot 3 y Base de Datos H2
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

maven.install(
    artifacts = [
        "org.springframework.boot:spring-boot-starter-web:3.2.0",
        "org.springframework.boot:spring-boot-starter-thymeleaf:3.2.0",
        "org.springframework.boot:spring-boot-starter-data-jpa:3.2.0",
        "com.h2database:h2:2.2.224",
        "jakarta.persistence:jakarta.persistence-api:3.1.0",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)

use_repo(maven, "maven")
